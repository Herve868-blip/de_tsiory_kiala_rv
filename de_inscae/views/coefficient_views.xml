<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_coefficient_tree" model="ir.ui.view">
        <field name="name">de_inscae.coefficient.tree</field>
        <field name="model">de_inscae.coefficient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="coefficient"/>
            </tree>
        </field>
    </record>
    <record id="view_coefficient_form" model="ir.ui.view">
        <field name="name">de_inscae.coefficient.form</field>
        <field name="model">de_inscae.coefficient</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="coefficient"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_coefficient" model="ir.actions.act_window">
        <field name="name">Coefficients</field>
        <field name="res_model">de_inscae.coefficient</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>