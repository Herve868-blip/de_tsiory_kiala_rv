<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste -->
     <record id="view_individu_tree" model="ir.ui.view"> <!-- Ny Vues rehetra dia stockées ao anaty table ir_ui_views daholo ary io id io no atao identifiant-any (mila unique izany io).  -->
        <field name="name">de_inscae.individu.tree</field><!-- Ity ny nom technique an'ilay vue. Convention : nom_module.nom_modèle.type_vue -->
        <field name="model">de_inscae.individu</field><!-- Ilay modèle rattaché amin'ilay vue. (Ilay _name amin'ilay modèle iny no atao eo) -->
        <field name="arch" type="xml"><!-- Ity ny architecture an'ilay vue -->
            <tree><!-- Ny dikan'ny hoe tree dia hoe vue liste io. Chaque Field est une colonne du tableau. -->
                <field name="nom_complet"/>
                <field name="genre"/>
                <field name="telephone"/>
            </tree>
        </field>
     </record>
     <record id="view_individu_form" model="ir.ui.view">
        <field name="name">de_inscae.individu.form</field>
        <field name="model">de_inscae.individu</field>
        <field name="arch" type="xml">
            <form><!-- Vue Fiche détail ny dikan'ny hoe form amin'ny Odoo -->
                <sheet><!-- Le corps de la fiche, comme une feuille de papier -->
                    <group><!-- Regroupe les champs en 2 colonnes automatiquement -->
                        <field name="nom"/>
                        <field name="prenoms"/>
                    </group>
                    <notebook>
                        <page string="Informations Personnelles">
                            <group>
                                <field name="genre"/>
                                <field name="date_naissance"/>
                                <field name="lieu_naissance"/>
                                <field name="cin"/>
                                <field name="est_malagasy"/>
                            </group>
                        </page>
                        <page string="Contact">
                            <group>
                                <field name="telephone"/>
                                <field name="email"/>
                                <field name="adresse"/>
                            </group>
                        </page>
                        <page string="Baccalauréat">
                            <group>
                                <field name="serie_bac"/>
                                <field name="mention_bac"/>
                                <field name="centre_bac"/>
                                <field name="annee_bac"/>
                                <field name="etablissement_origine"/>
                            </group>
                        </page>
                        <page string="Garant">
                            <group>
                                <field name="nom_complet_garant"/>
                                <field name="telephone_garant"/>
                                <field name="adresse_garant"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
     </record>
     <!-- Action -->
     <record id="action_individu" model="ir.actions.act_window">
        <field name="name">Individus</field>
        <field name="res_model">de_inscae.individu</field>
        <field name="view_mode">tree,form</field>
     </record>
</odoo>