<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_prof_tree" model="ir.ui.view">
        <field name="name">de_inscae.prof.tree</field>
        <field name="model">de_inscae.prof</field>
        <field name="arch" type="xml">
            <tree>
                <field name="appellation"/>
                <field name="nomcomplet"/>
                <field name="type_prof"/>
                <field name="email"/>
                <field name="telephone"/>
            </tree>
        </field>
    </record>

    <record id="view_prof_form" model="ir.ui.view">
        <field name="name">de_inscae.prof.form</field>
        <field name="model">de_inscae.prof</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Informations Personnelles">
                            <field name="appellation"/>
                            <field name="nomcomplet" placeholder="Nom Complet"/>
                            <field name="genre"/>
                            <field name="type_prof"/>
                        </group>
                        <group string="Contact">
                            <field name="email"/>
                            <field name="telephone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prof" model="ir.actions.act_window">
        <field name="name">Professeurs</field>
        <field name="res_model">de_inscae.prof</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>