<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_regle_admission_tree" model="ir.ui.view">
        <field name="name">de_inscae.regle_admission.tree</field>
        <field name="model">de_inscae.regle_admission</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="moyenne_admission_min"/>
                <field name="moyenne_deliberation_min"/>
            </tree>
        </field>
    </record>
    <record id="view_regle_admission_form" model="ir.ui.view">
        <field name="name">de_inscae.regle_admission.form</field>
        <field name="model">de_inscae.regle_admission</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="est_verrouillee" invisible="1"/>
                    <div class="alert alert-warning"
                         attrs="{'invisible': [('est_verrouillee', '=', False)]}">
                        Cette règle est verrouillée — elle est utilisée par une ou plusieurs sessions
                        et ne peut plus être modifiée.
                    </div>
                    <group>
                        <field name="name"
                               attrs="{'readonly': [('est_verrouillee', '=', True)]}"/>
                        <field name="moyenne_admission_min"
                               attrs="{'readonly': [('est_verrouillee', '=', True)]}"/>
                        <field name="moyenne_deliberation_min"
                               attrs="{'readonly': [('est_verrouillee', '=', True)]}"/>
                    </group>
                    <notebook>
                        <page string="Règles par Coefficient">
                            <field name="detail_ids"
                                   attrs="{'readonly': [('est_verrouillee', '=', True)]}">
                                <tree editable="bottom">
                                    <field name="coefficient_id"/>
                                    <field name="note_admission"/>
                                    <field name="note_deliberation"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_regle_admission" model="ir.actions.act_window">
        <field name="name">Règles d'Admission</field>
        <field name="res_model">de_inscae.regle_admission</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>