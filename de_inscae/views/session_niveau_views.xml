<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste -->
     <record id="view_session_niveau_tree" model="ir.ui.view"> <!-- Ny Vues rehetra dia stockées ao anaty table ir_ui_views daholo ary io id io no atao identifiant-any (mila unique izany io).  -->
        <field name="name">de_inscae.session_niveau.tree</field><!-- Ity ny nom technique an'ilay vue. Convention : nom_module.nom_modèle.type_vue -->
        <field name="model">de_inscae.session_niveau</field><!-- Ilay modèle rattaché amin'ilay vue. (Ilay _name amin'ilay modèle iny no atao eo) -->
        <field name="arch" type="xml"><!-- Ity ny architecture an'ilay vue -->
            <tree><!-- Ny dikan'ny hoe tree dia hoe vue liste io. Chaque Field est une colonne du tableau. -->
                <field name="code"/>
                <field name="intitule"/>
                <field name="niveau_id"/>
                <field name="option_id"/>
                <field name="session_niveau_precedente_id"/>
            </tree>
        </field>
     </record>
     <record id="view_session_niveau_form" model="ir.ui.view">
        <field name="name">de_inscae.session_niveau.form</field>
        <field name="model">de_inscae.session_niveau</field>
        <field name="arch" type="xml">
            <form><!-- Vue Fiche détail ny dikan'ny hoe form amin'ny Odoo -->
                <sheet><!-- Le corps de la fiche, comme une feuille de papier -->
                    <group><!-- Regroupe les champs en 2 colonnes automatiquement -->
                        <field name="code"/>
                        <field name="intitule"/>
                        <field name="niveau_id"/>
                        <field name="niveau_has_options" invisible="1"/>
                        <field name="option_id" 
                                domain="[('niveau_id', '=', niveau_id)]"
                                attrs="{'invisible': [('niveau_has_options', '=', False)]}"/>
                        <field name="session_niveau_precedente_id"/>
                    </group>
                </sheet>
            </form>
        </field>
     </record>
     <!-- Action -->
     <record id="action_session_niveau" model="ir.actions.act_window">
        <field name="name">Sessions Niveaux</field>
        <field name="res_model">de_inscae.session_niveau</field>
        <field name="view_mode">tree,form</field>
     </record>
</odoo>