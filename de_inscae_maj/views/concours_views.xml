<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_concours_tree" model="ir.ui.view">
        <field name="name">de_inscae.concours.tree</field>
        <field name="model">de_inscae.concours</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="libelle"/>
                <field name="formation_id"/>
                <field name="session_calendrier_id"/>
            </tree>
        </field>
    </record>

    <record id="view_concours_form" model="ir.ui.view">
        <field name="name">de_inscae.concours.form</field>
        <field name="model">de_inscae.concours</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="libelle"/>
                        <field name="formation_id" options="{'no_create_edit':True}"/>
                        <field name="session_calendrier_id" domain="[('session_parente_id.formation_id', '=', formation_id)]"  options="{'no_create_edit':True}"/>
                    </group>
                    <notebook>
                        <page string="Candidats">
                            <field name="candidat_ids">
                                <tree editable="bottom">
                                    <field name="individu_id" options="{'no_create_edit':True}"/>
                                    <field name="resultat"/>
                                    <button name="action_transformer_en_etudiant"
                                            type="object"
                                            string="Transformer en Étudiant"
                                            icon="fa-user-plus"
                                            attrs="{'invisible': ['|', ('resultat', '!=', 'Admis'), ('etudiant_id', '!=', False)]}"/>
                                    <field name="etudiant_id" readonly="1" attrs="{'invisible': [('etudiant_id', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_concours" model="ir.actions.act_window">
        <field name="name">Concours</field>
        <field name="res_model">de_inscae.concours</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>