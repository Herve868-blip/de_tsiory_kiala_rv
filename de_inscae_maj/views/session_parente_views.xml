       </field>
    </record>
    <!-- Action Sessions Parentes FC -->
    <record id="action_session_parente_fc" model="ir.actions.act_window">
       <field name="name">Sessions Parentes FC</field>
       <field name="res_model">de_inscae.session_parente_fc</field>
       <field name="view_mode">tree,form</field>
       <field name="context">{'default_formation_id': 2}</field>
    </record>
</odoo>