<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vues Sessions Parentes FI -->
    <record id="view_session_parente_fi_tree" model="ir.ui.view"> <!-- Ny Vues rehetra dia stockées ao anaty table ir_ui_views daholo ary io id io no atao identifiant-any (mila unique izany io).  -->
       <field name="name">de_inscae.session_parente_fi.tree</field><!-- Ity ny nom technique an'ilay vue. Convention : nom_module.nom_modèle.type_vue -->
       <field name="model">de_inscae.session_parente_fi</field><!-- Ilay modèle rattaché amin'ilay vue. (Ilay _name amin'ilay modèle iny no atao eo) -->
       <field name="arch" type="xml"><!-- Ity ny architecture an'ilay vue -->
           <tree><!-- Ny dikan'ny hoe tree dia hoe vue liste io. Chaque Field est une colonne du tableau. -->
               <field name="code"/>
               <field name="libelle"/>
               <field name="session_niveau_id"/>
               <field name="mois_debut"/>
               <field name="mois_fin"/>
           </tree>
       </field>
    </record>
    <record id="view_session_parente_form" model="ir.ui.view">
       <field name="name">de_inscae.session_parente_fi.form</field>
       <field name="model">de_inscae.session_parente_fi</field>
       <field name="arch" type="xml">
           <form><!-- Vue Fiche détail ny dikan'ny hoe form amin'ny Odoo -->
               <sheet><!-- Le corps de la fiche, comme une feuille de papier -->
                   <group><!-- Regroupe les champs en 2 colonnes automatiquement -->
                       <field name="code"/>
                       <field name="libelle"/>
                       <field name="formation_id" domain="[('sigle', '=', 'FI')]" readonly="1"/>
                       <field name="session_niveau_id" domain="[('niveau_id.formation_id.sigle', '=', 'FI')]" />
                       <field name="mois_debut"/>
                       <field name="mois_fin"/>
                   </group>
               </sheet>
           </form>
       </field>
    </record>
    <!-- Action Sessions Parentes FI -->
    <record id="action_session_parente_fi" model="ir.actions.act_window">
       <field name="name">Sessions Parentes FI</field>
       <field name="res_model">de_inscae.session_parente_fi</field>
       <field name="view_mode">tree,form</field>
       <field name="context">{'default_formation_id': 1}</field>
    </record>
