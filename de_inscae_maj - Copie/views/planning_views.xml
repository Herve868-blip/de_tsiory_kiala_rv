<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planning_form" model="ir.ui.view">
        <field name="name">de_inscae.planning.form</field>
        <field name="model">de_inscae.planning</field>
        <field name="arch" type="xml">
            <form string="Planning">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Groupe &amp; Matière">
                            <field name="groupe_id"
                                   options="{'no_create': 1, 'no_quick_create': 1, 'no_create_edit': 1}"/>
                            <field name="type_groupe" readonly="1"/>
                            <field name="matiere_id"
                                   options="{'no_create': 1, 'no_quick_create': 1, 'no_create_edit': 1}"/>
                            <field name="prof_id" options="{'no_create': 1, 'no_quick_create': 1, 'no_create_edit': 1}"/>
                        </group>
                        <group string="Créneau">
                            <field name="jour_semaine"/>
                            <field name="tranche_horaire_id"
                                   options="{'no_create': 1, 'no_quick_create': 1, 'no_create_edit': 1}"/>
                            <field name="salle_id"
                                   options="{'no_create': 1, 'no_quick_create': 1, 'no_create_edit': 1}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Période">
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>